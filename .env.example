# Docker exposes the app on http://localhost:8080.
APP_BIND=127.0.0.1
APP_PORT=8080

# Users configure their own API in Settings > Translation.
# Keep this encryption key file together with database backups.
# Docker overrides this path to /data/translation.key (persistent database volume).
TRANSLATION_KEY_FILE=./data/translation.key
# Enable only on a trusted deployment to allow HTTP/private model endpoints.
TRANSLATION_ALLOW_LOCAL=false
TRANSLATION_TIMEOUT=45
TRANSLATION_CONCURRENCY=2
TRANSLATION_QUEUE_SIZE=32

# Set true when accessing exclusively over HTTPS (e.g. your HTTPS tunnel).
COOKIE_SECURE=false
SESSION_DAYS=7
# Normally unnecessary: same-origin HTTP and WebSocket are accepted automatically.
ALLOWED_ORIGINS=

SPEECH_ENABLED=true
# Multilingual base balances CPU latency and accuracy. small is slower;
# tiny is faster with lower recognition accuracy, especially for Vietnamese.
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_CPU_THREADS=4
SPEECH_SILENCE_MS=400
SPEECH_MAX_SEGMENT_MS=4000
SPEECH_PREVIEW_MS=1000
LANGUAGE_CONFIDENCE=0.60
AUDIO_QUEUE_SIZE=4
