# Docker exposes the app on http://localhost:8080.
APP_BIND=127.0.0.1
APP_PORT=8080

# Existing OpenAI-compatible LLM gateway. Native backend: localhost instead of host.docker.internal.
# Do not use the optional compose.translation*.yaml overlays for gateway mode.
TRANSLATION_BACKEND=openai
TRANSLATION_BASE_URL=http://host.docker.internal:20128/v1
TRANSLATION_MODEL=cx/gpt-6-luna
TRANSLATION_API_KEY=
TRANSLATION_TIMEOUT=45
TRANSLATION_CONCURRENCY=2
TRANSLATION_QUEUE_SIZE=32

# Set true when accessing exclusively over HTTPS (e.g. your HTTPS tunnel).
COOKIE_SECURE=false
SESSION_DAYS=7
# Comma-separated administrator usernames (case-insensitive).
# WARNING: whoever registers "admin" first gets administrator access by default.
# Register your admin before exposing the app; set empty to disable admin access.
ADMIN_USERNAMES=admin
# Normally unnecessary: same-origin HTTP and WebSocket are accepted automatically.
ALLOWED_ORIGINS=

SPEECH_ENABLED=true
# Nemotron multilingual ASR (Transformers); CPU by default.
SPEECH_BACKEND=nemotron
SPEECH_MODEL=nvidia/nemotron-3.5-asr-streaming-0.6b
SPEECH_DEVICE=cpu
SPEECH_CPU_THREADS=4
SPEECH_DOWNLOAD_ROOT=./models
# Legacy fallback, used only with SPEECH_BACKEND=whisper:
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_CPU_THREADS=4
SPEECH_SILENCE_MS=400
SPEECH_MAX_SEGMENT_MS=4000
SPEECH_PREVIEW_MS=1000
LANGUAGE_CONFIDENCE=0.60
AUDIO_QUEUE_SIZE=4
