# Local diagnostic URL; backend stays private on the Docker network.
APP_BIND=127.0.0.1
APP_PORT=38471

# Bootstrap only: after first creation, database password is authoritative.
# Username: 3-32 lowercase letters/digits/._-; password: 8-128 characters.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Required Fernet key. Generate once and KEEP it with database backups:
# .venv/bin/python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SETTINGS_ENCRYPTION_KEY=

# Configure URL, API key and model in Admin > Translation settings after login.
# Existing TRANSLATION_BASE_URL/MODEL/API_KEY env values are imported once only.
TRANSLATION_TIMEOUT=45
TRANSLATION_CONCURRENCY=2
TRANSLATION_QUEUE_SIZE=32

# Named Tunnel: Dashboard public hostname -> http://frontend:80
# Tunnel-scoped connector token only, not a Cloudflare account API key.
# Set token then: docker compose --profile tunnel up -d --build
CLOUDFLARE_TUNNEL_TOKEN=
# MUST be true when using public HTTPS; false for local HTTP diagnostics.
COOKIE_SECURE=false
SESSION_DAYS=7
# Usually empty: same-origin HTTP and WebSocket are accepted automatically.
ALLOWED_ORIGINS=
AUTH_RATE_LIMIT=60

SPEECH_ENABLED=true
SPEECH_MODEL=nvidia/nemotron-3.5-asr-streaming-0.6b
SPEECH_DEVICE=cpu
SPEECH_CPU_THREADS=4
SPEECH_DOWNLOAD_ROOT=./models
SPEECH_SILENCE_MS=400
SPEECH_MAX_SEGMENT_MS=4000
SPEECH_PREVIEW_MS=1000
LANGUAGE_CONFIDENCE=0.60
AUDIO_QUEUE_SIZE=4
